# Copy to .env and fill values. .env is gitignored.
OPENAI_API_KEY=sk-...

# Optional: switch voice provider to Groq (Whisper-large-v3-turbo for STT,
# PlayAI for TTS — English-only voices, do not use for Ukrainian TTS).
# VOICE_PROVIDER=groq
# GROQ_API_KEY=gsk-...

# Optional model overrides:
# VOICE_TRANSCRIBE_MODEL=whisper-large-v3
# VOICE_TTS_MODEL=playai-tts

# Optional port override:
# LIVE_WEB_CHAT_PORT=8787
